<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.karla.tablademultiplicar.PrimaryController">
   <children>
       <Label text="Dado un entero calcula su tabla de multiplicar"/>
        <Label text="Tabla del número" />
        <TextField fx:id="Digito" promptText="Escribe el número del que quieras su tabla"/>
        
        <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="Cal" text="Calcular" onAction="#Calcular" />
        <Button fx:id="Lim" text="Limpiar" onAction="#Limpiar" />
        </HBox>
        
        <TextArea fx:id="txtAreaResultado" editable="false" prefHeight="150.0" promptText="Resultado..." />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>